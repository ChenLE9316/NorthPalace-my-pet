{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NorthPalace-my-pet",
  "version": "0.1.0",
  "identifier": "com.northpalace.mypet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Lenvu",
        "width": 540,
        "height": 430,
        "minWidth": 360,
        "minHeight": 300,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
