{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NorthPalace-my-pet",
  "version": "0.1.0",
  "identifier": "com.northpalace.mypet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Lenvu",
        "width": 360,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      },
      {
        "label": "companion",
        "title": "Lenvu Companion",
        "width": 390,
        "height": 650,
        "minWidth": 340,
        "minHeight": 480,
        "transparent": false,
        "decorations": true,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
